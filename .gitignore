data/facilities/*.csv

# 調査の作業ファイル（進捗の記録は調査のたびに書き換わり、YAMLに反映した時点で役目を終える）
data/research/
data/facilities/.research-progress*.json

# Claude Code（個人設定のみ除外。settings.json やコマンド類は共有する）
.claude/settings.local.json
.claude/*.local.json

# 作業用ドキュメント（コミット対象外）
docs/schema-review.md

# Playwright CLI の作業ログ（調査時に出る）
.playwright-cli/
