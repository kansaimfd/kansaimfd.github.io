{
  "name": "kansai-mfd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-data.mjs && vite",
    "build": "node scripts/build-data.mjs && tsc -b && vite build && node scripts/build-static-pages.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run data && npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build && npm run check:dist"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^5.0.1"
  }
}
